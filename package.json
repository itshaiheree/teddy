{
  "name": "teddy-ai",
  "version": "1.2.0",
  "description": "AI agent CLI — support Anthropic & OpenAI-compatible API, zero dependencies",
  "keywords": [
    "coding-agent",
    "cli",
    "ai",
    "anthropic",
    "openai",
    "llm"
  ],
  "homepage": "https://github.com/itshaiheree/teddy#readme",
  "bugs": {
    "url": "https://github.com/itshaiheree/teddy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itshaiheree/teddy.git"
  },
  "license": "MIT",
  "author": "nijushidigital",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "teddy": "bin/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "start": "node --no-deprecation --loader ts-node/esm src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const f='bin/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node --no-deprecation\\n'+c)\"",
    "dev": "node --no-deprecation --loader ts-node/esm src/index.ts",
    "test": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "arg": "^4.1.3",
    "create-require": "^1.1.1",
    "diff": "^4.0.4",
    "make-error": "^1.3.6",
    "undici-types": "^6.21.0",
    "v8-compile-cache-lib": "^3.0.1",
    "yn": "^3.1.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
